class Solution {
public:
    int scoreDifference(vector<int>& nums) {
        int n = nums.size();
        int plr1 = 0, plr2 = 0;
        int status = 0;

        for(int i = 0; i < n; i++){
            if((nums[i] % 2 == 1) || ((i+1) % 6 == 0)){
                status = abs(1 - status);
            }
            if((nums[i] % 2 == 1) && ((i+1) % 6 == 0)){
                status = abs(1 - status);
            }
            if(status == 1) plr2 += nums[i];
            else plr1 += nums[i];
        }
        return plr1 - plr2;
    }
};
