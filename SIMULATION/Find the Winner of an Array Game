class Solution {
public:
    int getWinner(vector<int>& arr, int k) {
        int n = arr.size();
        int maxi = *max_element(arr.begin(), arr.end());
        if(k >= n) return maxi;

        int curr = arr[0], win = 0;
        for(int i = 1; i < n; i++){
            if(arr[i] > curr){
                curr = arr[i];
                win = 0;
            }
            win++; 
            if(win == k) break;
        }
        return curr;
    }
};
