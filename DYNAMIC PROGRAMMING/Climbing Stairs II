class Solution {
public:
    // memoization
    int solve(int i, vector<int> &costs, vector<int> &dp){
        if(i == 0) return 0;
        if(dp[i] != -1) return dp[i];
        int ans = 1e9;
        for(int j = 1; j <= 3; j++){
            if(i-j >= 0){
                ans = min(ans, costs[i-1] + j*j + solve(i-j, costs, dp));
            }
        }
        return dp[i] = ans;
    }

    int climbStairss(int n, vector<int>& costs) {
        vector<int> dp(n+1, -1);
        return solve(n, costs, dp);
    }

    // tabulation
    int climbStairs(int n, vector<int>& costs) {
        vector<int> dp(n+1, -1);
        dp[0] = 0;
        
        for(int i = 1; i <= n; i++){
            int ans = 1e9;
            for(int j = 1; j <= 3; j++){
                if(i-j >= 0){
                    ans = min(ans, costs[i-1] + j*j + dp[i-j]);
                }
            }
            dp[i] = ans;
        }
        return dp[n];
    }
};
