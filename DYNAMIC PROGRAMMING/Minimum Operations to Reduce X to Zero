class Solution {
public:
    int solve(int i, int j, int x, vector<int> &nums, vector<vector<vector<int>>> &dp){
        if(x == 0) return 0;
        if(i > j || x < 0) return 1e9;
        if(i == j) return nums[i] == x ? 1 : 1e9;
        if(dp[i][j][x] != -1) return dp[i][j][x];
        int left = 1 + solve(i+1, j, x - nums[i], nums, dp);
        int right = 1 + solve(i, j-1, x - nums[j], nums, dp);
        return dp[i][j][x] = min(left, right);
    }

    int minOperations(vector<int>& nums, int x) {
        int n = nums.size();
        vector<vector<vector<int>>> dp(n, vector<vector<int>>(n, vector<int>(x+1, -1)));
        int ans = solve(0, n-1, x, nums, dp);
        return ans >= 1e9 ? -1 : ans;
    }
};
