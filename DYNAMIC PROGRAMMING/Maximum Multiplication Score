class Solution {
public:
    typedef long long ll;
    ll solve(int i, int j, vector<int>  &a, vector<int> &b, vector<vector<ll>> &dp){
        int n = b.size();
        if(j >= n && i < 4) return -1e18;
        if(i == 4) return 0;
        if(dp[i][j] != -1) return dp[i][j];
        ll noTake = solve(i, j+1, a, b, dp);
        ll take = (1LL * a[i] * b[j]) + solve(i+1, j+1, a, b, dp);
        return dp[i][j] = max(take, noTake);
    }

    ll maxScore(vector<int>& a, vector<int>& b) {
        int n = b.size();
        vector<vector<ll>> dp(4, vector<ll>(n+1, -1));
        return solve(0, 0, a, b, dp);
    }
};
