class Solution {
public:
    //memoization
    int dp[501][501];
    int solve(int i, int j, vector<int> &prefix){
        int n = prefix.size();
        if(i == j) return 0;
        if(dp[i][j] != -1) return dp[i][j];

        int score = 0;
        for(int k = i; k < j; k++){
            int lSum = (i > 0) ? prefix[k] - prefix[i-1] : prefix[k];
            int rSum = prefix[j] - prefix[k];
            if(lSum < rSum) {
                score = max(score, lSum + solve(i, k, prefix));
            }
            else if(lSum > rSum) {
                score = max(score, rSum + solve(k+1, j, prefix));
            }
            else {
                score = max({score, lSum + solve(i, k, prefix), rSum + solve(k+1, j, prefix)});
            }
        }
        return dp[i][j] = score;
    }

    int stoneGameeV(vector<int>& stone) {
        int n = stone.size();
        memset(dp, -1, sizeof(dp));

        vector<int> prefix(n);
        prefix[0] = stone[0];
        for(int i = 1; i < n; i++){
            prefix[i] = prefix[i-1] + stone[i];
        }
        return solve(0, n-1, prefix);
    }

    // tabulation
    int stoneGameV(vector<int>& stone) {
        int n = stone.size();
        vector<vector<int>> dp(n+1, vector<int> (n+1, 0));
        vector<int> prefix(n);

        prefix[0] = stone[0];
        for(int i = 1; i < n; i++){
            prefix[i] = prefix[i-1] + stone[i];
        }

        for(int i = n-2; i >= 0; i--){
            for(int j = 1; j < n; j++){
                int score = 0;
                for(int k = i; k < j; k++){
                    int lSum = (i > 0) ? prefix[k] - prefix[i-1] : prefix[k];
                    int rSum = prefix[j] - prefix[k];
                    if(lSum < rSum) {
                        score = max(score, lSum + dp[i][k]);
                    }
                    else if(lSum > rSum) {
                        score = max(score, rSum + dp[k+1][j]);
                    }
                    else {
                        score = max({score, lSum + dp[i][k], rSum + dp[k+1][j]});
                    }
                }
                dp[i][j] = score;
            }
        }
        return dp[0][n-1];
    }
};
