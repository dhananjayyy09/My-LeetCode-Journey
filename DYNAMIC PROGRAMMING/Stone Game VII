class Solution {
public:
    // memoization
    int dp[1001][1001];
    int solve(int i, int j, vector<int> &stones, vector<int> &prefix){
        int n = stones.size();
        if(i == j) return 0;
        if(dp[i][j] != -1) return dp[i][j];
        int sum = (i > 0) ? prefix[j] - prefix[i-1] : prefix[j];
        int left = (sum - stones[i]) - solve(i+1, j, stones, prefix);
        int right = (sum - stones[j]) - solve(i, j-1, stones, prefix);
        return dp[i][j] = max(left, right); 
    }

    int stoneGameeVII(vector<int>& stones) {
        int n = stones.size();
        memset(dp, -1, sizeof(dp));

        vector<int> prefix(n);
        prefix[0] = stones[0];
        for(int i = 1; i < n; i++){
            prefix[i] = prefix[i-1] + stones[i];
        }        
        return solve(0, n-1, stones, prefix);
    }

    // tabulation
    int stoneGameVII(vector<int>& stones) {
        int n = stones.size();
        vector<vector<int>> dp(n, vector<int> (n, 0));

        vector<int> prefix(n);
        prefix[0] = stones[0];
        for(int i = 1; i < n; i++){
            prefix[i] = prefix[i-1] + stones[i];
        }  

        for(int i = n-2; i >= 0; i--){
            for(int j = i+1; j < n; j++){
                int sum = (i > 0) ? prefix[j] - prefix[i-1] : prefix[j];
                int left = (sum - stones[i]) - dp[i+1][j];
                int right = (sum - stones[j]) - dp[i][j-1];
                dp[i][j] = max(left, right); 
            }
        }   
        return dp[0][n-1];
    }
};
