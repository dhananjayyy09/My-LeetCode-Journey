class Solution {
public:
    // memoization
    int solve(int i, int j, int xr, vector<vector<int>> &grid, vector<vector<vector<int>>> &dp){
        int m = grid.size(), n = grid[0].size();
        if(i >= m || j >= n) return 1e9;
        if(i == m-1 && j == n-1) return xr ^ grid[m-1][n-1];
        if(dp[i][j][xr] != -1) return dp[i][j][xr];
        int right = solve(i, j+1, xr ^ grid[i][j], grid, dp);
        int down = solve(i+1, j, xr ^ grid[i][j], grid, dp);
        return dp[i][j][xr] = min(right, down);
    }

    int minCostt(vector<vector<int>>& grid) {
        int m = grid.size(), n = grid[0].size();
        vector<vector<vector<int>>> dp(m, vector<vector<int>>(n, vector<int>(1024, -1)));
        return solve(0, 0, 0,grid, dp);
    }

    // tabulation
    int minCost(vector<vector<int>>& grid) {
        int m = grid.size(), n = grid[0].size();
        vector<vector<vector<int>>> dp(m+1, vector<vector<int>>(n+1, vector<int>(1024, 1e9)));
        for(int xr = 0; xr < 1024; xr++){
            dp[m-1][n-1][xr] = xr ^ grid[m-1][n-1];
        }

        for(int i = m-1; i >= 0; i--){
            for(int j = n-1; j >= 0; j--){
                if(i == m-1 && j == n-1) continue;
                
                for(int xr = 0; xr < 1024; xr++){
                    int nwXr = xr ^ grid[i][j];
                    int right = (j+1 < n) ? dp[i][j+1][nwXr] : 1e9;
                    int down = (i+1 < m) ? dp[i+1][j][nwXr] : 1e9;
                    dp[i][j][xr] = min(right, down);
                }
            }
        }
        return dp[0][0][0];
    }
};
