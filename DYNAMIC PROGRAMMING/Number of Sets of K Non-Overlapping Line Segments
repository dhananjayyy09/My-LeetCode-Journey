class Solution {
public:
    const int MOD = 1e9 + 7;
    // memoization
    int dp[1001][1001];
    int solve(int i, int n, int k){
        if(k == 0) return 1;
        if(i >= n) return 0;
        if(dp[i][k] != -1) return dp[i][k];
        int noTake = solve(i+1, n, k);
        int take = 0;
        for(int j = i+1; j < n; j++){
            take = (take + solve(j, n, k-1)) % MOD;
        }
        return dp[i][k] = (take + noTake) % MOD;
    }

    int numberOfSetss(int n, int k) {
        memset(dp, -1, sizeof(dp));
        return (solve(0, n, k)) % MOD;
    }

    // tabulation
    int numberOfSets(int n, int k) {
        vector<vector<int>> dp(n+1, vector<int> (k+1, 0));
        for(int i = 0; i <= n; i++){
            dp[i][0] = 1;
        }

        for(int i = n-1; i >= 0; i--){
            for(int tk = 1; tk <= k; tk++){
                int noTake = dp[i+1][tk];
                int take = 0;
                for(int j = i+1; j < n; j++){
                    take = (take + dp[j][tk-1]) % MOD;
                }
                dp[i][tk] = (take + noTake) % MOD;
            }
        }
        return (dp[0][k]) % MOD;
    }
};
