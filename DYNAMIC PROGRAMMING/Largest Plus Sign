class Solution {
public:
    void fillLeft(vector<vector<int>> &left, vector<vector<int>> &grid){
        int n = grid.size();
        for(int i = 0; i < n; i++){
            for(int j = 0; j < n; j++){
                if(j == 0) left[i][j] = grid[i][j];
                else if(grid[i][j] == 1) left[i][j] = 1 + left[i][j-1];
                else left[i][j] = 0;
            }
        }
    }

    void fillRight(vector<vector<int>> &right, vector<vector<int>> &grid){
        int n = grid.size();
        for(int i = 0; i < n; i++){
            for(int j = n-1; j >= 0; j--){
                if(j == n-1) right[i][j] = grid[i][j];
                else if(grid[i][j] == 1) right[i][j] = 1 + right[i][j+1];
                else right[i][j] = 0;
            }
        }
    }

    void fillUp(vector<vector<int>> &up, vector<vector<int>> &grid){
        int n = grid.size();
        for(int j = 0; j < n; j++){
            for(int i = 0; i < n; i++){
                if(i == 0) up[i][j] = grid[i][j];
                else if(grid[i][j] == 1) up[i][j] = 1 + up[i-1][j];
                else up[i][j] = 0;
            }
        }
    }
    
    void fillDown(vector<vector<int>> &down, vector<vector<int>> &grid){
        int n = grid.size();
        for(int j = 0; j < n; j++){
            for(int i = n-1; i >= 0; i--){
                if(i == n-1) down[i][j] = grid[i][j];
                else if(grid[i][j] == 1) down[i][j] = 1 + down[i+1][j];
                else down[i][j] = 0;
            }
        }
    }

    int orderOfLargestPlusSign(int n, vector<vector<int>>& mines) {
        vector<vector<int>> grid(n, vector<int>(n, 1));
        for(int i = 0; i < mines.size(); i++){
            int x = mines[i][0], y = mines[i][1];
            grid[x][y] = 0;
        }

        vector<vector<int>> left(n, (vector<int> (n, 0)));
        vector<vector<int>> right(n, (vector<int> (n, 0)));
        vector<vector<int>> up(n, (vector<int> (n, 0)));
        vector<vector<int>> down(n, (vector<int> (n, 0)));
        
        fillLeft(left, grid);
        fillRight(right, grid);
        fillUp(up, grid);
        fillDown(down, grid);

        int ans = 0;
        for(int i = 0; i < n; i++){
            for(int j = 0; j < n; j++){
                ans = max(ans, min({left[i][j], right[i][j], up[i][j], down[i][j]}));
            }
        }
        return ans;
    }
};s
