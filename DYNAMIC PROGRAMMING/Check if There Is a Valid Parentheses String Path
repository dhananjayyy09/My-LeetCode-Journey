class Solution {
public:
    int dp[105][105][205];
    vector<pair<int, int>> dir = {{0, 1}, {1, 0}};
    bool solve(int i, int j, int open, vector<vector<char>> &grid){
        int m = grid.size(), n = grid[0].size();
        if(open < 0) return 0;
        if(i == m-1 && j == n-1) return open == 0;

        if(dp[i][j][open] != -1) return dp[i][j][open];
        bool ans = 0;
        for(auto [dx, dy] : dir){
            int nr = i + dx, nc = j + dy;
            if(nr < m && nc < n) {
                if(grid[nr][nc] == '('){
                    ans |= solve(nr, nc, open+1, grid);
                } else {
                    ans |= solve(nr, nc, open-1, grid);
                }
            }
        }
        return dp[i][j][open] = ans;
    }

    bool hasValidPath(vector<vector<char>>& grid) {
        int m = grid.size(), n = grid[0].size();
        if(grid[0][0] == ')' || grid[m-1][n-1] == '(') return 0;
        memset(dp, -1, sizeof(dp));
        return solve(0, 0, 1, grid);
    }
};
