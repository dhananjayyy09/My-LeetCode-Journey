class Solution {
public:
    string ans = "";
    char midC = '$';
    int half;
    bool solve(int i, bool found, string curr, string &target, vector<int> &freq){
        if(curr.size() == half){
            string s1 = curr;
            string s2 = curr;
            reverse(s2.begin(), s2.end());
            
            if(midC != '$') s1 += midC;
            s1 += s2;

            if(s1 > target){
                ans = s1;
                return true;
            }
        }

        for(char c = 'a'; c <= 'z'; c++){
            if(freq[c-'a'] == 0) continue;
            if(!found && c < target[i]) continue;

            curr.push_back(c);
            freq[c-'a']--;
            bool grtr = found || c > target[i];
            if(solve(i+1, grtr, curr, target, freq)) return true;
            curr.pop_back();
            freq[c-'a']++;
        }
        return false;
    }

    string lexPalindromicPermutation(string s, string target) {
        int n = s.size();
        vector<int> freq(26, 0);
        for(auto &c : s){
            freq[c-'a']++;
        }

        int odd = 0;
        for(int c = 0; c < 26; c++){
            if(freq[c] % 2 == 1){
                odd++;
                midC = c+'a';
            }
        }
        if(odd > 1) return "";

        for(int c = 0; c < 26; c++){
            freq[c] /= 2;
        }

        half = n/2;
        solve(0, false, "", target, freq);
        return ans;
    }
};
