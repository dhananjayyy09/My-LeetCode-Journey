class Solution {
public:
    vector<string> ans;
    void solve(string curr, int o, int c, int n){
        if(curr.size() == 2*n) {
            ans.push_back(curr);
            return;
        }

        if(o < n){
            curr.push_back('(');
            solve(curr, o+1, c, n);
            curr.pop_back();
        }
        if(c < o){
            curr.push_back(')');
            solve(curr, o, c+1, n);
            curr.pop_back();
        }
    }

    vector<string> generateParenthesis(int n) {
        solve("", 0, 0, n);
        return ans;
    }
};
