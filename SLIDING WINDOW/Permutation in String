class Solution {
public:
    bool checkInclusion(string s1, string s2) {
        int m = s1.size(), n = s2.size();
        vector<int> f1(26, 0), f2(26, 0);
        for(int i = 0; i < m; i++){
            f1[s1[i] -'a']++;
        }

        int i = 0,  j = 0;
        while(j < n){
            f2[s2[j] -'a']++;
            while(j-i+1 > m){
                f2[s2[i] -'a']--;
                i++;
            }
            if(j-i+1 == m && f1 == f2) return 1;
            j++;
        }
        return 0;
    }
};
