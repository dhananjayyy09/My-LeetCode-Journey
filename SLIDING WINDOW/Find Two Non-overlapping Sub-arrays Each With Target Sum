class Solution {
public:
    int minSumOfLengths(vector<int>& arr, int target) {
        int n = arr.size();
        vector<int> pre(n, 1e9);
        int ans = 1e9;
        int sum = 0, i = 0, best = 1e9;

        for(int j = 0; j < n; j++){
            sum += arr[j];
            while(i < j && sum > target){
                sum -= arr[i];
                i++;
            }

            if(sum == target){
                int len = j-i+1;
                if(i > 0 && pre[i-1] != 1e9){
                    ans = min(ans, len + pre[i-1]);
                }
                best = min(best, len);
            }
            pre[j] = best;
        }
        return ans == 1e9 ? -1 : ans;
    }
};
