class Solution {
public:
    int longestMountain(vector<int>& arr) {
        int n = arr.size();
        vector<int> right(n, 0);
        vector<int> left(n, 0);
        for(int i=1; i<n; i++){
            if(arr[i] > arr[i-1]){
                left[i] = left[i-1] + 1;
            }
        }
        for(int i = n-2; i >= 0; i--){
            if(arr[i] > arr[i+1]){
                right[i] = right[i+1] + 1;
            }
        }

        int maxLen = 0;
        for(int i=0; i<n; i++){
            int val = left[i] + right[i] + 1;
            if(left[i] == 0 || right[i] == 0) val = 0;
            maxLen = max(maxLen, val);
        }
        return maxLen;
    }

    // OPTIMAL
    int longestMountain(vector<int>& arr) {
            int n = arr.size();
            if(n < 3) return 0;
            int maxLen = 0, inc = 0, dec = 0;
            
            for(int i = 1; i < n; i++){
                if(arr[i] > arr[i-1]){
                    if(dec > 0) inc = 0;
                    inc++;
                    dec = 0;
                }
                else if(arr[i] < arr[i-1]){
                    if(inc > 0) {
                        dec++;
                        maxLen = max(maxLen, inc + dec + 1);
                    }
                }
                else {
                    inc = 0;
                    dec = 0;
                }
            }
            return maxLen;
        }
};
