class Solution {
public:
    vector<int> validSequence(string s, string t) {
        int m = s.size(), n = t.size();
        vector<int> mchRyt(m+1, 0);
        int match = 0, j = n-1;
       
        for(int i = m-1; i >= 0; i--){
            if(j >= 0 && s[i] == t[j]){
                match++;         
                j--;
            }
            mchRyt[i] = match;
        }

        vector<int> ans;
        bool canChange = true;
        j = 0;
        for(int i = 0; i < m && j < n; i++){
            if(s[i] == t[j]){
                ans.push_back(i);
                j++;
            }
            else if(canChange && mchRyt[i+1] >= n-j-1){
                ans.push_back(i);
                canChange = false;
                j++;
            }
        }

        if(j == n) return ans;
        return {};
    }
};
