class Solution {
public:
    int getMaxRepetitions(string s1, int n1, string s2, int n2) {
        int m1 = s1.size(), m2 = s2.size();
        int c1 = 0, c2 = 0;
        int i = 0, j = 0;

        while(c1 < n1){
            if(s1[i] == s2[j]){
                j++;
                if(j == m2){
                    c2++;
                    j = 0;
                }
            }
            i++;

            if(i == m1){
                c1++;
                i = 0;
            }
        }
        return c2 / n2;
    }
};
