class Solution {
public:
    int firstStableIndex(vector<int>& nums, int k) {
        int n = nums.size();
        int mini = 1e9, maxi = -1e9;
        vector<int> mins(n), maxs(n);

        for(int i = 0; i < n; i++){
            maxi = max(maxi, nums[i]);
            maxs[i] = maxi;
        }
        for(int i = n-1; i >= 0; i--){
            mini = min(mini, nums[i]);
            mins[i] = mini;
        }

        for(int i = 0; i < n; i++){
            int score = maxs[i] - mins[i];
            if(score <= k) return i;
        }
        return -1;
    }
};
