class Solution {
public:
    int firstStableIndex(vector<int>& nums, int k) {
        int n = nums.size();
        int mini = 1e9, maxi = -1e9;
        vector<int> suffMin(n), prefMax(n);

        for(int i = 0; i < n; i++){
            maxi = max(maxi, nums[i]);
            prefMax[i] = maxi;
        }
        for(int i = n-1; i >= 0; i--){
            mini = min(mini, nums[i]);
            suffMin[i] = mini;
        }

        for(int i = 0; i < n; i++){
            int score = prefMax[i] - suffMin[i];
            if(score <= k) return i;
        }
        return -1;
    }
};
