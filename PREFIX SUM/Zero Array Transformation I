class Solution {
public:
    bool isZeroArray(vector<int>& nums, vector<vector<int>>& queries) {
        int n = nums.size();
        vector<int> diff(n, 0);
        for(auto &it : queries){
            int l = it[0], r = it[1];
            diff[l]++;
            if(r+1 < n) diff[r+1]--;
        }

        int preSum = 0;
        for(int i = 0; i < n; i++){
            preSum += diff[i];
            if(preSum < nums[i]) return 0;
        }
        return 1;
    }
};
