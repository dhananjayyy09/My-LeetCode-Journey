class Solution {
public:
    int longestSubarray(vector<int>& nums) {
        int n = nums.size();
        vector<int> pre(n, 1), suff(n, 1);
        
        pre[0] = 1;
        for(int i = 1; i < n; i++){
            if(nums[i-1] <= nums[i]) {
                pre[i] = 1 + pre[i-1];
            }
            else pre[i] = 1;
        }

        suff[0] = 1;
        for(int i = n-2; i >= 0; i--){
            if(nums[i+1] >= nums[i]) {
                suff[i] = 1 + suff[i+1];
            }
            else suff[i] = 1;
        }

        int ans = 1;
        for(int i = 0; i < n; i++){
            if(i > 0){
                ans = max(ans, 1 + pre[i-1]);
            }
            if(i < n-1){
                ans = max(ans, 1 + suff[i+1]);
            }
            if(i > 0 && i < n-1 && nums[i-1] <= nums[i+1]){
                ans = max(ans, 1 + pre[i-1] + suff[i+1]);
            }
        }
        return ans;
    }
};
