class Solution {
public:
    int sortPermutation(vector<int>& nums) {
        int n = nums.size();
        int ans, idx = -1;
        for(int i = 0; i < n; i++){
            if(nums[i] != i) {
                ans = nums[i];
                idx = i;
                break;
            }
        }
        if(idx == -1) return 0;

        for(int i = idx; i < n; i++){
            if(nums[i] != i) {
                ans &= nums[i];
            }
        }
        return ans;
    }
};
