class Solution {
public:
    int getSum(int num){
        int sum = 0;
        while(num){
            sum += (num % 10);
            num /= 10;
        }
        return sum;
    }

    int minSwaps(vector<int>& nums) {
        int n = nums.size();
        unordered_map<int, int> mp;
        for(int i = 0; i < n; i++){
            mp[nums[i]] = i; 
        }

        vector<int> sorted = nums;
        sort(sorted.begin(), sorted.end(), [this](int n1, int n2){
            int sum1 = getSum(n1);
            int sum2 = getSum(n2);
            if(sum1 != sum2) return sum1 < sum2;
            return n1 < n2;
        });

        int swaps = 0;
        for(int i = 0; i < n; i++){
            int expVal = sorted[i];
            int curVal = nums[i];
            if(expVal == curVal) continue;

            int idx = mp[expVal];
            nums[i] = expVal;
            nums[idx] = curVal;

            mp[expVal] = i;
            mp[curVal] = idx;
            swaps++;
        }
        return swaps;
    }
};
