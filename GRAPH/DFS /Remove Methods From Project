class Solution {
public:
    void markSpcs(int node, vector<vector<int>> &adj, vector<int> &spcs){
        spcs[node] = 1;
        for(auto &it : adj[node]){
            if(!spcs[it]) {
                markSpcs(it, adj, spcs);
            }
        }
    }

    vector<int> remainingMethods(int n, int k, vector<vector<int>>& invocations) {
        vector<vector<int>> adj(n);
        for(auto &it : invocations){
            int u = it[0], v = it[1];
            adj[u].push_back(v);
        }

        vector<int> spcs(n, 0);
        markSpcs(k, adj, spcs);

        for(auto &it : invocations){
            int u = it[0], v = it[1];
            if(!spcs[u] && spcs[v]){
                vector<int> ans;
                for(int i = 0; i < n; i++) ans.push_back(i);
                return ans;
            }
        }

        vector<int> ans;
        for(int i = 0; i < n; i++){
            if(!spcs[i]) ans.push_back(i);
        }
        return ans;
    }
};
