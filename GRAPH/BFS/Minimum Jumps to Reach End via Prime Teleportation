class Solution {
public:
    bool isPrime(int num){
        if(num < 2) return 0;
        for(int i = 2; i*i <= num; i++){
            if(num % i == 0) return 0;
        }
        return 1;
    }

    int minJumps(vector<int>& nums) {
        int n = nums.size();
        unordered_map<int, vector<int>> mp;

        for(int i = 0; i < n; i++){
            int x = nums[i];
            for(int p = 2; p*p <= x; p++){
                if(x % p == 0 &&isPrime(p)){
                    mp[p].push_back(i);

                    while(x % p == 0) x /= p;
                }
            }

            if(x > 1 && isPrime(x)) {
                mp[x].push_back(i);
            }
        } 

        unordered_set<int> seen;
        queue<int> q;
        vector<int> vis(n, 0);
        q.push(0);
        vis[0] = 1;
        int steps = 0;
        
        while(!q.empty()){
            int sz = q.size();

            while(sz--){
                auto i = q.front();
                q.pop();

                if(i == n-1) return steps;
                if(i > 0 && !vis[i-1]){
                    vis[i-1] = 1;
                    q.push(i-1);
                }

                if(i < n-1 && !vis[i+1]){
                    vis[i+1] = 1;
                    q.push(i+1);
                }

                if(isPrime(nums[i])){
                    int p = nums[i];
                    if(!seen.count(p)){
                        seen.insert(p);

                        for(int j : mp[p]){
                            if(!vis[j]){
                                vis[j] = 1;
                                q.push(j);
                            }
                        }
                    }
                }
            }
            steps++;
        }
        return -1;
    }
};
