class Solution {
public:
    bool canReach(string s, int minJump, int maxJump) {
        int n = s.size();
        if(s[n-1] == '1') return false;
        vector<int> dp(n, 0);
        dp[0] = 1;
        long long count = 0;

        for(int j = 1; j < n; j++){
            if(j - minJump >= 0) {
                count += dp[j - minJump];
            }
            if(j-1 - maxJump >= 0) {
                count -= dp[j-1 - maxJump];
            }
            if(count > 0 && s[j] == '0'){
                dp[j] = 1;
            }
        }
        return dp[n-1];
    }
};s
