class Solution {
public:
    int maxSum(vector<int>& nums) {
        int n = nums.size();
        unordered_set<int> st;
        int sum = 0;
        for(int i = 0; i < n; i++){
            if(nums[i] > 0 && !st.count(nums[i])){
                sum += nums[i];
                st.insert(nums[i]);
            }
        }
        int negSum = *max_element(nums.begin(), nums.end());
        return sum > 0 ? sum : negSum;
    }
}; 
