class Solution {
public:
    int stoneGameVI(vector<int>& a, vector<int>& b) {
        int n = a.size();
        vector<pair<int, int>> stones;
        for(int i = 0; i < n; i++){
            stones.push_back({a[i] + b[i], i});
        }
        sort(stones.rbegin(), stones.rend());

        int alice = 0, bob = 0;
        int idx = 0;        
        for(auto [val, i] : stones){
            if(idx % 2 == 0) alice += a[i];
            else bob += b[i];
            idx++;
        };

        if(alice == bob) return 0;
        return alice > bob ? 1 : -1;
    }
};
