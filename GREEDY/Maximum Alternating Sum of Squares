class Solution {
public:
    long long maxAlternatingSum(vector<int>& nums) {
        int n = nums.size();
        for(auto &it : nums){
            it = abs(it);
        }

        sort(nums.begin(), nums.end());
        long long score = 0;
        int i = 0, j = n-1;

        while(i < j){
            score += (nums[j] * nums[j]);
            score -= (nums[i] * nums[i]);
            j--;
            i++;
        }
        if(n % 2 == 1) score += (nums[j] * nums[j]);
        return score;
    }
};
