class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {
        int m = nums1.size(), n = nums2.size();
        vector<int> ans(m, -1);

        for(int i = 0; i < m; i++){
            int j = 0;
            while(j < n && nums1[i] != nums2[j]) {
                j++;
            }
            if(j == n) continue;

            while(j < n) {
                if(nums2[j] > nums1[i]) {
                    ans[i] = nums2[j];
                    break;
                } 
                j++;
            }
        }
        return ans;
    }
};
