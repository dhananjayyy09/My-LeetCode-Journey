class Solution {
public:
    int countMatchingSubarrays(vector<int>& nums, vector<int>& pattern) {
        int n = nums.size(), m = pattern.size();
        int ans = 0;
        for(int i = 0; i < n-m; i++){
            bool ok = 1;
            for(int k = 0; k < m; k++){
                if(pattern[k] == 1){
                    if(nums[i+k+1] <= nums[i+k]) ok = 0;
                }
                else if(pattern[k] == 0){
                    if(nums[i+k+1] != nums[i+k]) ok = 0;
                }
                else {
                    if(nums[i+k+1] >= nums[i+k]) ok = 0;
                }
            }
            if(ok) ans++;
        }
        return ans;
    }
};
