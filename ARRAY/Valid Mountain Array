class Solution {
public:
    bool validMountainArray(vector<int>& arr) {
        int n = arr.size();
        if(n <= 2) return false;

        vector<int> trend(n, 0);
        for(int i = 1; i < n; i++){
            if(arr[i] > arr[i-1]) trend[i-1] = 1;
            else if(arr[i] < arr[i-1]) trend[i] = -1;
            else return 0;
        }
        if(trend[0] == 0 || trend[n-1] == 0) return false;

        int peak = 0;
        for(int i = 1; i < n-1; i++) {
            if(trend[i] == 0) peak++;
        }
        return peak == 1;
    }
};
