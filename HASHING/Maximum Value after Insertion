class Solution {
public:
    string maxValue(string s, int x) {
        string ans;
        string nm = to_string(x);

        if (s[0] != '-') {
            int i = 0;
            while (i < s.size() && (s[i] - '0') >= x) i++;
            ans = s.substr(0, i) + nm + s.substr(i);
        }
        else {
            int i = 1; 
            while (i < s.size() && (s[i] - '0') <= x) i++;
            ans = s.substr(0, i) + nm + s.substr(i);
        }
        return ans;
    }
};
