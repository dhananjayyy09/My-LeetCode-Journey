class Solution {
public:
    vector<int> findMissingElements(vector<int>& nums) {
        int maxi = -1e9, mini = 1e9;
        for(auto it : nums){
            maxi = max(maxi, it);
            mini = min(mini, it);
        }

        unordered_set st(nums.begin(),nums.end());
        vector<int> ans;
        for(int x = mini; x <= maxi; x++){
            if(!st.count(x)) ans.push_back(x);
        }
        return ans;
    }
};
