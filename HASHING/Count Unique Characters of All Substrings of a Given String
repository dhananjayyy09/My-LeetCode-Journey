class Solution {
public:
    int uniqueLetterString(string s) {
        int n = s.size();
        vector<int> prev(n), next(n);
        vector<int> last(26, -1);

        for(int i = 0; i < n; i++){
            prev[i] = last[s[i] - 'A'];
            last[s[i] - 'A'] = i;
        }

        fill(last.begin(), last.end(), n);
        for(int i = n-1; i >= 0; i--){
            next[i] = last[s[i] - 'A'];
            last[s[i] - 'A'] = i;
        }

        int ans = 0;
        for(int i = 0; i < n; i++){
            ans += (i - prev[i]) * (next[i] - i);
        }
        return ans;
    }
};
