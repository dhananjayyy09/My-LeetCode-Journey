class Solution {
public:
    long long countMajoritySubarrays(vector<int>& nums, int target) {
        int n = nums.size();
        unordered_map<int, int> mp;
        mp[0] = 1;
        long long ans = 0;
        long long preSum = 0, valid = 0;

        for(auto &x : nums){
            if(x == target){
                valid += mp[preSum];
                preSum++;
            }
            else {
                preSum--;
                valid -= mp[preSum];
            }
            ans += valid;
            mp[preSum]++;
        }
        return ans;
    }
};
