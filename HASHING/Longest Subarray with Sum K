class Solution {
  public:
    int longestSubarray(vector<int>& arr, int k) {
        int n = arr.size();
        unordered_map<int, int> mp;
        int ans = 0;        
        int i = 0, sum = 0;
        
        for(int j = 0; j < n; j++){    
            sum += arr[j];
            if(sum == k) ans = j+1;
            
            int target = sum - k;
            if(mp.count(target)){
                ans = max(ans, j - mp[target]);
            }
            if(!mp.count(sum)){
                mp[sum] = j;
            }
        }        
        return ans;
    }
};
