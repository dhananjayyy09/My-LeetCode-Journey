class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {
        unordered_map<int, int> mp;
        stack<int> st;

        for(auto &num : nums2){
            while(!st.empty() && st.top() < num){
                mp[st.top()] = num;
                st.pop();
            }
            st.push(num);
        }

        vector<int> ans;
        for(auto &num : nums1){
            int curr = mp.count(num) ? mp[num] : -1;
            ans.push_back(curr);
        }
        return ans;
    }
};
