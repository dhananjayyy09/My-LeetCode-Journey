class Solution {
public:
    bool canShip(int limit, int days, vector<int> &weights){
        int count = 1, sum = 0;
        for(auto &x : weights){
            if(sum + x > limit){
                count++;
                sum = x;
            }
            else sum += x;
        }
        return count <= days;
    }

    int shipWithinDays(vector<int>& weights, int days) {
        int low = 0, high = 0;
        for(auto &it : weights){
            low = max(it, low);
            high += it;
        }

        int ans = 0;
        while(low <= high){
            int mid = low + (high - low) / 2;
            if(canShip(mid, days, weights)){
                ans = mid;
                high = mid - 1;
            }
            else low = mid + 1;
        } 
        return ans;
    }
};
