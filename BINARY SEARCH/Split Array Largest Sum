class Solution {
public:
    bool canFit(int limit, int k, vector<int> &nums){
        int n = nums.size();
        int count = 1, sum = 0;

        for(int i = 0; i < n; i++){
            if(sum + nums[i] > limit){
                count++;
                sum = nums[i];
            }
            else sum += nums[i];
        }
        return count <= k;
    }

    int splitArray(vector<int>& nums, int k) {
        int n = nums.size();
        int low = 0, high = 0;
        for(auto &it : nums){
            low = max(it, low);
            high += it;
        }

        int ans = 0;
        while(low <= high){
            int mid = low + (high - low) / 2;
            if(canFit(mid, k, nums)) {
                ans = mid;
                high = mid - 1;
            }
            else low = mid + 1;
        }
        return ans;
    }
};
