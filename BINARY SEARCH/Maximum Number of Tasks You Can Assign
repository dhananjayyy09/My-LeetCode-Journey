class Solution {
public:
    bool isPossible(int mid, vector<int>& t, vector<int>& w, int p, int s){
        int used = 0;
        multiset<int> st(w.begin(), w.begin() + mid);

        for(int i = mid-1; i >= 0; i--){
            int req = t[i];
            auto it = prev(st.end());
        
            if(*it >= req){
                st.erase(it);
            }
            else if(used >= p) return false;
            else {
                auto weakest = st.lower_bound(req - s);
                if(weakest == st.end()) return false;
                st.erase(weakest);
                used++;
            }
        }
        return true;    
    }

    int maxTaskAssign(vector<int>& t, vector<int>& w, int p, int s) {
        int m = t.size(), n = w.size();
        sort(t.begin(), t.end());
        sort(w.rbegin(), w.rend());
        
        int l = 0, r = min(m, n);
        int ans;

        while(l <= r){
            int mid = l + (r-l) / 2;
            if(isPossible(mid, t, w, p, s )) {
                ans = mid;
                l = mid + 1;
            } 
            else {
                r = mid - 1;
            } 
        }
        return ans;        
    }
};
