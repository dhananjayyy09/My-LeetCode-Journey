class Solution {
public:
    bool isValid(int mid, vector<int> &nums, int k){
        long long sum = 0;
        for(auto &x : nums){
            sum += ((x + mid-1) / mid);
        }
        return sum <= k;
    }

    int smallestDivisor(vector<int>& nums, int k) {
        int n = nums.size();
        int l = 1;
        int h = *max_element(nums.begin(), nums.end());
        int ans = h;
        
        while(l <= h){
            int mid = l + (h-l) / 2;
            if(isValid(mid, nums, k)){
                ans = mid;
                h = mid-1;
            } 
            else l = mid+1;
        }
        return ans;
    }
};
