class Solution {
public:
    vector<pair<int, int>> dir = {{0, -1}, {0, 1}, {-1, 0}, {1, 0}};
    bool isPossible(int sf, vector<vector<int>> &dist){
        int n = dist.size();
        if (dist[0][0] < sf) return false;

        vector<vector<int>> vis(n, vector<int>(n, 0));
        queue<pair<int, int>> q;
        q.push({0, 0});
        vis[0][0] = 1;

        while(!q.empty()){
            auto [r, c] = q.front();
            q.pop();

            if(r == n-1 && c == n-1) return true;
            for(auto [dx, dy] : dir){
                int nr = r + dx, nc = c + dy;
                if(nr >= 0 && nr < n && nc >= 0 && nc < n && !vis[nr][nc] && dist[nr][nc] >= sf){
                    q.push({nr, nc});
                    vis[nr][nc] = 1;
                }
            }
        }
        return false;
    }

    int maximumSafenessFactor(vector<vector<int>>& grid) {
        int n = grid.size();
        vector<vector<int>> dist(n, vector<int>(n, -1));
        vector<vector<int>> vis(n, vector<int>(n, 0));
        queue<pair<int, int>> q;

        for(int i = 0; i < n; i++){
            for(int j = 0; j < n; j++){
                if(grid[i][j] == 1){
                    q.push({i, j});
                    vis[i][j] = 1;
                }
            }
        }

        int lvl = 0;
        while(!q.empty()){
            int sz = q.size();
            while(sz--){
                auto [r, c] = q.front();
                q.pop();
                dist[r][c] = lvl;

                for(auto [dx, dy] : dir){
                    int nr = r + dx, nc = c + dy;
                    if(nr >= 0 && nr < n && nc >= 0 && nc < n && !vis[nr][nc]){
                        q.push({nr, nc});
                        vis[nr][nc] = 1;
                    }
                }
            }            
            lvl++;
        }

        int ans = 0;
        int l = 0, h = 400;

        while(l <= h){
            int mid = l + (h-l) / 2;
            if(isPossible(mid, dist)){
                ans = mid;
                l = mid+1;
            }
            else h = mid-1;
        }
        return ans;
    }
}; 
