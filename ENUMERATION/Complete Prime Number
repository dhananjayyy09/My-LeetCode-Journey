class Solution {
public:
    bool isPrime(string s){
        int num = stoi(s);
        if(num < 2) return 0;
        for(int p = 2; p*p <= num; p++){
            if(num % p == 0) return 0;
        }
        return 1;
    }

    bool completePrime(int num) {
        string s = to_string(num);
        int n = s.size();
        for(int i = 1; i <= n; i++){
            string pre = s.substr(0, i);
            string suff = s.substr(n-i, i);
            if(!isPrime(pre) || !isPrime(suff)) return 0; 
        }
        return 1;
    }
};
