class Solution {
public:
    typedef pair<long long, int> P;
    long long kSum(vector<int>& nums, int k) {
        int n = nums.size(); 
        long long maxSum = 0;
        for(int i = 0; i < n; i++){
            if(nums[i] > 0) maxSum += nums[i];
            else nums[i] = abs(nums[i]);
        }

        vector<long long> ans;
        priority_queue<P> pq;
        sort(nums.begin(), nums.end());
        
        ans.push_back(maxSum);
        pq.push({maxSum - nums[0], 0});

        while(!pq.empty() && ans.size() < k){
            auto [sum, i] = pq.top();
            pq.pop();

            ans.push_back(sum);
            if(i < n-1){
                pq.push({sum - nums[i+1], i+1});
                pq.push({sum - nums[i+1] + nums[i], i+1});
            }
        }
        return ans[k-1];
    }
};
