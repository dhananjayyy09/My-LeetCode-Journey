class Solution {
public:
    vector<int> maxSlidingWindow(vector<int>& nums, int k) {
        int n = nums.size();
        priority_queue<pair<int,int>> pq;
        vector<int> ans;

        int i = 0;
        for(int j = 0; j < n; j++){
            pq.push({nums[j], j});
            while(!pq.empty() && pq.top().second < i) {
                pq.pop();
            }
            if(j-i+1 == k){
                ans.push_back(pq.top().first);
                i++;
            }
        }
        return ans;
    }
};
