class Solution {
public:
    string removeOuterParentheses(string s) {
        int n = s.size();
        string ans = "";
        int lvl = 0;
        
        for(auto &c : s){
            if(c == '('){
                if(lvl > 0) ans += c;
                lvl++;
            }
            else {
                lvl--;
                if(lvl > 0) ans += c;
            }
        }
        return ans;
    }
};
