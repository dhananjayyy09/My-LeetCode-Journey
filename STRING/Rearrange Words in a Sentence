class Solution {
public:
    string arrangeWords(string s) {
        int n = s.size();
        s[0] = tolower(s[0]);

        vector<tuple<int, int, string>> v;
        for(int i = 0; i < n; i++){
            int j = i;
            string curr = "";
            while(j < n && s[j] != ' ') {
                curr += s[j];
                j++;
            }
            v.push_back({j-i, j, curr});
            i = j;
        }
        
        sort(v.begin(), v.end());
        string ans = "";
        for(auto [len, idx, str] : v){
            ans += str + " ";
        }

        ans.pop_back();
        ans[0] = toupper(ans[0]);
        return ans;
    }
};
