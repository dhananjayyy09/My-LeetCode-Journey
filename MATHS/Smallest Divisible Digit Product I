class Solution {
public:
    int getProduct(int num){
        int pro = 1;
        while(num > 0){
            pro *= (num % 10);
            num /= 10;
        }
        return pro;
    }

    int smallestNumber(int n, int t) {
        while(getProduct(n) % t != 0) n++;
        return n; 
    }
};
