class Solution {
public:
    const int MOD = 1e9 + 7;
    long long nCr(int n, int r) {
        if (r > n) return 0;
        vector<long long> fact(n + 1, 1);
        for (int i = 1; i <= n; i++) {
            fact[i] = (fact[i - 1] * i) % MOD;
        }

        long long a = fact[r];
        long long b = fact[n - r];
        long long denominator = (a * b) % MOD;
        long long inverse = power(denominator, MOD - 2);
        
        return (fact[n] * inverse) % MOD;
    }

    long long power(long long a, long long b) {
        long long ans = 1;
        while (b > 0) {
            if (b & 1) ans = (ans * a) % MOD;
            a = (a * a) % MOD;
            b >>= 1;
        }
        return ans;
    }

    long long solve(vector<int>& nums) {
        int n = nums.size();
        if (n <= 2) return 1;

        int root = nums[0];
        vector<int> left, right;
        for (int i = 1; i < n; i++) {
            if (nums[i] > root) right.push_back(nums[i]);
            else left.push_back(nums[i]);
        }

        long long leftC = solve(left);
        long long rightC = solve(right);
        long long ways = nCr(n - 1, left.size());
        return (((leftC * rightC) % MOD) * ways) % MOD;
    }

    int numOfWays(vector<int>& nums) {
        return (solve(nums) - 1 + MOD) % MOD;
    }
};
