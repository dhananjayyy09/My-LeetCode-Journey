class Solution {
public:
    int maximumProduct(vector<int>& nums) {
        int max1 = -1e9, max2 = -1e9, max3 = -1e9;
        int min1 = 1e9, min2 = 1e9;
        for(auto &num : nums){
            if(num >= max1){
                max3 = max2;
                max2 = max1;
                max1 = num;
            }
            else if(num >= max2){
                max3 = max2;
                max2 = num;
            }
            else if(num >= max3){
                max3 = num;
            }

            if(num <= min1){
                min2 = min1;
                min1 = num;
            }
            else if(num <= min2){
                min2 = num;
            }
        }
        return max((min1 * min2 * max1), (max1 * max2 * max3));
    }
};
