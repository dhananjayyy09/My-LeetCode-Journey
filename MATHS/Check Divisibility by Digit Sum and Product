class Solution {
public:
    bool checkDivisibility(int n) {
        long long sum = 0, pro = 1;
        int temp = n;
        while(temp){
            int nm = temp % 10;
            sum += nm;
            pro *= nm;
            temp /= 10;
        }
        long long total = sum + pro;
        return n % total == 0;
    }
};
